# ═══════════════════════════════════════════════════════════════
#  VED Foundation — PRODUCTION Environment Variables
#  Copy this to .env on the server and fill in real values
#  NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=production

# ── MongoDB ────────────────────────────────────────────────────
# Option A: MongoDB Atlas (recommended — free tier available)
#   Sign up at mongodb.com/atlas → Create cluster → Get URI
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ved_foundation?retryWrites=true&w=majority

# Option B: MongoDB on same VPS (if you installed MongoDB locally)
# MONGO_URI=mongodb://127.0.0.1:27017/ved_foundation

# ── Security ──────────────────────────────────────────────────
# Generate new secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=PASTE_YOUR_64_CHAR_RANDOM_STRING_HERE
JWT_EXPIRES_IN=7d

# ── Field Encryption (optional but recommended) ───────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPT_KEY=PASTE_YOUR_32_BYTE_HEX_HERE

# ── Gmail SMTP (for email campaigns) ─────────────────────────
# Step 1: Gmail → Settings → Security → Enable 2FA
# Step 2: Gmail → Security → App Passwords → Generate for "Mail"
# Step 3: Paste the 16-char password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_real_gmail@gmail.com
SMTP_PASS=your16charapppassword
SMTP_FROM_NAME=VED Foundation

# ── Backup ───────────────────────────────────────────────────
BACKUP_KEEP_DAYS=7

# ── Domain (for CORS) — your actual domain ───────────────────
# ALLOWED_ORIGINS=https://vededufoundation.in,https://www.vededufoundation.in
