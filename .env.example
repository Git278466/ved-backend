# ─── Copy this file to .env and fill in your values ───────────

PORT=5000
NODE_ENV=development

# MongoDB — change to your Atlas URI in production
MONGO_URI=mongodb://localhost:27017/ved_foundation

# JWT — use a long random string in production
JWT_SECRET=VED_SUPER_SECRET_JWT_KEY_CHANGE_IN_PRODUCTION_2024
JWT_EXPIRES_IN=7d

# CORS — add your frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000

# Seed credentials (used by seed/seedAdmin.js)
SEED_SUPER_ADMIN_EMAIL=superadmin@vedfoundation.org
SEED_SUPER_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_EMAIL=admin@vedfoundation.org
SEED_ADMIN_PASSWORD=Admin@1234
